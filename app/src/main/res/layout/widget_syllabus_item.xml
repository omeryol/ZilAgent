<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/widget_item_glass"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/class_color_strip"
        android:layout_width="4dp"
        android:layout_height="24dp"
        android:background="#6200EE" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lesson_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8A - Matematik"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/lesson_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:10 - 08:50"
            android:textColor="#AAAAAA"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/note_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="8dp"
        android:src="@android:drawable/ic_menu_edit"
        android:tint="#FFC107"
        android:visibility="gone" />
    
    <TextView
        android:id="@+id/lesson_order"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1"
        android:textColor="#44FFFFFF"
        android:textStyle="bold"
        android:textSize="18sp" />

</LinearLayout>
